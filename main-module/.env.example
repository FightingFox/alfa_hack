# Application
APP_NAME=main-module
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=info

# External masking services (REST and/or WebSocket)
# JSON list: [{"name": "...", "protocol": "rest|websocket", "url": "...", "timeout": 10.0,
#              "pool": {"min_connections": 4, "max_connections": 64, "idle_shrink_interval": 5.0}}]
MASKING_SERVICES=[{"name":"default","protocol":"websocket","url":"ws://localhost:9000","timeout":10.0,"pool":{"min_connections":4,"max_connections":64}}]

# Redis for payload_id correlation
REDIS_URL=redis://localhost:6379/0