# Провайдер ALFA (alfagen) — OpenAI-совместимый эндпоинт
LLM_BASE_URL=https://alfagen.alfabank.ru/continue-dev/
LLM_API_KEY=your-alfa-api-key
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Внутренний эндпоинт использует приватный CA — отключаем проверку SSL
LLM_VERIFY_SSL=false

# Провайдер DeepSeek (публичный) — участвует в гонке с ALFA
DS_BASE_URL=https://api.deepseek.com/v1
DS_API_KEY=your-deepseek-api-key
DS_MODEL=deepseek-flash
# max_tokens=4096 обязателен: при 1024 deepseek-flash часто возвращает пустой ответ
DS_MAX_TOKENS=4096
DS_VERIFY_SSL=true