worker_processes auto;

events {
    worker_connections 1024;
}

http {
    upstream gliner_famous {
        # Round robin по умолчанию. Список серверов генерируется entrypoint.sh
        # из переменной окружения GLINER_BACKENDS.
${GLINER_UPSTREAM}
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 80;

        # WebSocket-эндпоинт: /gliner-famous/ws -> /ws
        location /gliner-famous/ws {
            proxy_pass http://gliner_famous/ws;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # HTTP-эндпоинт: /gliner-famous/process -> /process
        location /gliner-famous/process {
            proxy_pass http://gliner_famous/process;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 300s;
        }
    }
}