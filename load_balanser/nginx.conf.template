worker_processes auto;

events {
    worker_connections 1024;
}

http {
    # Встроенный DNS Docker. Имена бэкендов резолвятся в момент запроса,
    # а не при старте nginx, поэтому nginx не падает, если бэкенд временно недоступен.
    resolver 127.0.0.11 valid=10s ipv6=off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

${UPSTREAM_DIRECTIVES}
    server {
        listen 80;
        # Метрики nginx для Prometheus (скрейпит nginx-prometheus-exporter)
        location /nginx_status {
            stub_status;
        }

${LOCATION_DIRECTIVES}
    }
}