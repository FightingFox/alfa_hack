worker_processes auto;

events {
    worker_connections 1024;
}

http {
    upstream gliner_famous {
        # Round robin по умолчанию. Список серверов генерируется entrypoint.sh
        # из переменной окружения GLINER_BACKENDS.
${GLINER_UPSTREAM}
    }

    upstream llm_service {
        # Список серверов генерируется entrypoint.sh из переменной LLM_BACKENDS.
${LLM_UPSTREAM}
    }

    upstream regex_module {
        # Список серверов генерируется entrypoint.sh из переменной REGEX_BACKENDS.
${REGEX_UPSTREAM}
    }

    upstream main_module {
        # Список серверов генерируется entrypoint.sh из переменной MAIN_BACKENDS.
${MAIN_UPSTREAM}
    }

    upstream ml_for_all_types {
        # Список серверов генерируется entrypoint.sh из переменной ML_BACKENDS.
${ML_UPSTREAM}
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 80;

        # WebSocket-эндпоинт: /gliner-famous/ws -> /ws
        location /gliner-famous/ws {
            proxy_pass http://gliner_famous/ws;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # HTTP-эндпоинт: /gliner-famous/process -> /process
        location /gliner-famous/process {
            proxy_pass http://gliner_famous/process;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 300s;
        }

        # WebSocket-эндпоинт: /llm-service/ws -> /ws
        location /llm-service/ws {
            proxy_pass http://llm_service/ws;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # HTTP-эндпоинт: /llm-service/process -> /process
        location /llm-service/process {
            proxy_pass http://llm_service/process;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 300s;
        }

        # WebSocket-эндпоинт: /regex-module/scan -> /scan
        location /regex-module/scan {
            proxy_pass http://regex_module/scan;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # HTTP-эндпоинт: /main-module/process -> /process
        location /main-module/process {
            proxy_pass http://main_module/process;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 300s;
        }

        # HTTP-эндпоинт: /main-module/health -> /health
        location /main-module/health {
            proxy_pass http://main_module/health;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 300s;
        }

        # WebSocket-эндпоинт: /ml-for-all-types/ws -> /ws
        location /ml-for-all-types/ws {
            proxy_pass http://ml_for_all_types/ws;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # HTTP-эндпоинт: /ml-for-all-types/process -> /process
        location /ml-for-all-types/process {
            proxy_pass http://ml_for_all_types/process;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 300s;
        }
    }
}